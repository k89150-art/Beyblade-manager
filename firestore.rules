rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.uid in [
          "SesDhvXG6MUT38YhqGl0N6lVgMz1"
        ];
    }

    function isCanonicalEntityId(value) {
      return value is string
        && value.matches('^ent_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$');
    }

    function isIsoDate(value) {
      return value is string
        && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isModelId(value) {
      return value is string
        && value.matches('^[a-z][a-z0-9-]{2,63}$');
    }

    function isModelVersion(value) {
      return value is string
        && value.matches(
          '^[0-9]+[.][0-9]+[.][0-9]+(-[0-9A-Za-z.-]+)?$'
        );
    }

    function isProductionMetaEnvelope() {
      return request.resource.data.dataMode == "production"
        && request.resource.data.schemaVersion == 1
        && request.resource.data.lifecycleStatus == "active"
        && !request.resource.data.keys().hasAny([
          "seed",
          "seedMarker",
          "developmentSeed"
        ]);
    }

    function validEvidenceCreate(evidenceId) {
      return request.resource.data.keys().hasOnly([
          "schemaVersion",
          "evidenceId",
          "entityId",
          "lifecycleStatus",
          "dataMode",
          "eventDate",
          "createdAt",
          "payload"
        ])
        && request.resource.data.evidenceId == evidenceId
        && isCanonicalEntityId(request.resource.data.entityId)
        && isIsoDate(request.resource.data.eventDate)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.payload is map
        && isProductionMetaEnvelope();
    }

    function validProfileWrite(entityId) {
      return request.resource.data.keys().hasOnly([
          "schemaVersion",
          "profileId",
          "entityId",
          "analysisRunId",
          "lifecycleStatus",
          "dataMode",
          "currentAt",
          "payload"
        ])
        && request.resource.data.profileId is string
        && request.resource.data.analysisRunId is string
        && request.resource.data.entityId == entityId
        && isCanonicalEntityId(request.resource.data.entityId)
        && request.resource.data.currentAt is timestamp
        && request.resource.data.payload is map
        && isProductionMetaEnvelope();
    }

    function validAnalysisResultWrite(entityId) {
      return request.resource.data.keys().hasOnly([
          "schemaVersion",
          "entityId",
          "analysisDate",
          "modelId",
          "modelVersion",
          "generatedAt",
          "lifecycleStatus",
          "dataMode",
          "traceReferences",
          "payload"
        ])
        && request.resource.data.entityId == entityId
        && isCanonicalEntityId(request.resource.data.entityId)
        && isIsoDate(request.resource.data.analysisDate)
        && isModelId(request.resource.data.modelId)
        && isModelVersion(request.resource.data.modelVersion)
        && request.resource.data.generatedAt is timestamp
        && request.resource.data.traceReferences is list
        && request.resource.data.payload is map
        && isProductionMetaEnvelope();
    }

    match /users/{userId}/appData/{documentId} {
      allow read: if documentId == "main" && isSignedIn() && (
        request.auth.uid == userId || isAdmin()
      );

      allow write: if documentId == "main" && isSignedIn() && request.auth.uid == userId;
    }

    match /{path=**}/appData/{documentId} {
      allow read: if isAdmin();
    }

    match /metaEvidence/{evidenceId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && validEvidenceCreate(evidenceId);
      allow update, delete: if false;
    }

    match /metaProfiles/{entityId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && validProfileWrite(entityId);
      allow update: if isAdmin()
        && validProfileWrite(entityId)
        && request.resource.data.entityId == resource.data.entityId
        && request.resource.data.profileId == resource.data.profileId;
      allow delete: if false;

      match /analysisResults/{resultId} {
        allow read: if isSignedIn();
        allow create: if isAdmin() && validAnalysisResultWrite(entityId);
        allow update: if isAdmin()
          && validAnalysisResultWrite(entityId)
          && request.resource.data.entityId == resource.data.entityId
          && request.resource.data.analysisDate == resource.data.analysisDate
          && request.resource.data.modelId == resource.data.modelId
          && request.resource.data.modelVersion == resource.data.modelVersion;
        allow delete: if false;
      }
    }
  }
}
